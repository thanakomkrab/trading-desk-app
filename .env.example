# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์จริงของคุณ (ห้าม commit ไฟล์ .env ขึ้น git)

# ขอได้ที่ https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ขอฟรีได้ที่ https://twelvedata.com/pricing (แผนฟรีพอสำหรับทดสอบ)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

PORT=3000
